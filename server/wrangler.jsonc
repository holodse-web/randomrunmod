{
  "name": "randomrun-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "RandomRunHub"
      }
